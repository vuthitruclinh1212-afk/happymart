rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User document and isolated subcollections
    match /users/{userId} {
      allow get, update, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;

      // Jars subcollection
      match /jars/{jarId} {
        allow read, write: if isOwner(userId) && isValidId(jarId);
      }

      // Wallets subcollection
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId) && isValidId(walletId);
      }

      // Transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) && isValidId(txId);
      }

      // Recurring expenses subcollection
      match /recurring/{recId} {
        allow read, write: if isOwner(userId) && isValidId(recId);
      }

      // Wishlist subcollection
      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(itemId);
      }

      // Asset depreciation subcollection
      match /assets/{assetId} {
        allow read, write: if isOwner(userId) && isValidId(assetId);
      }

      // Financial diary subcollection
      match /diary/{entryId} {
        allow read, write: if isOwner(userId) && isValidId(entryId);
      }

      // Favorite songs subcollection
      match /songs/{songId} {
        allow read, write: if isOwner(userId) && isValidId(songId);
      }
    }
  }
}
